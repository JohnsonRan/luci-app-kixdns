msgstr "自动刷新"

msgid "Refresh"
msgstr "刷新"

msgid "%d shown / %d matched"
msgstr "显示 %d 条 / 匹配 %d 条"

msgid "No log entries match the current filters."
msgstr "没有日志匹配当前过滤条件。"

msgid "No log entries in %s."
msgstr "%s 中暂无日志。"

msgid "Listening (from pipeline config)"
msgstr "监听地址（读取自 pipeline 配置）"

msgid "Log size limit (KB)"
msgstr "日志大小限制（KB）"

msgid "When the log file exceeds this size, it is cleared."
msgstr "日志文件超过此大小时将被清空。"

msgid "Clear log"
msgstr "清空日志"

msgid "Log file: %s"
msgstr "日志文件：%s"

msgid "Stats"
msgstr "统计"

msgid "KixDNS - Stats"
msgstr "KixDNS - 统计"

msgid "Query totals from dns_response logs for the current and previous 23 hours. Checkpointed every five minutes and on service stop. With a TypeSafe API key, eligible domain names are sent to TypeSafe for classification."
msgstr "统计当前及此前 23 个小时的 dns_response 日志，每五分钟及服务停止时保存。配置 TypeSafe API 密钥后，符合条件的域名会发送至 TypeSafe 进行分类。"

msgid "Queries"
msgstr "查询"

msgid "Cache hit rate"
msgstr "缓存命中率"

msgid "Errors"
